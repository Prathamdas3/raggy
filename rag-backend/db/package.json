{
	"name": "db",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"workers": "tsx ./src/services",
		"db:generate": "drizzle-kit generate",
		"db:clear": "tsx ./src/db/clear.ts",
		"db:reset": "npm run db:clear && npm run db:migrate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:up": "podman compose up -d",
		"db:down": "podman compose down",
		"lint": "biome lint",
		"check": "biome check --write",
		"format": "biome format"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.5",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.6",
		"hono": "^4.10.1",
		"pg": "^8.16.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@types/node": "^20.11.17",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.5",
		"tsx": "^4.7.1",
		"typescript": "^5.8.3"
	}
}
